  "name": "spacetimedb-cctv-dvr",
  "version": "1.0.5",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "spacetime:local": "spacetime start --listen-addr 127.0.0.1:3001 --data-dir .spacetimedb/local --non-interactive",
    "spacetime:build": "spacetime build --module-path spacetimedb --lint-dir ''",
    "spacetime:publish-local": "spacetime publish --server http://127.0.0.1:3001 --anonymous --yes --module-path spacetimedb --build-options='--lint-dir=' spacevision-dvr-local",
    "spacetime:bindings": "spacetime generate --lang typescript --out-dir client/src/lib/spacetimedb-bindings --module-path spacetimedb --build-options='--lint-dir='",
    "spacetime:validate-analysis": "tsx scripts/validate-local-analysis-flow.ts",
    "desktop:validate-roles": "tsx scripts/validate-local-analysis-flow.ts",
    "desktop:web:dev": "vite --config desktop/vite.config.ts",
    "desktop:web:build": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:check": "cargo check --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:build": "tauri build --config desktop/src-tauri/tauri.conf.json"
  },
